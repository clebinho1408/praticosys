# ──────────────────────────────────────────────────────────────
# Variáveis de ambiente para o Railway (Backend)
# Copie estas variáveis no painel do Railway:
#   Railway Dashboard → seu projeto → Variables
# ──────────────────────────────────────────────────────────────

NODE_ENV=production

# Banco de dados Neon (copie do seu .env.local atual)
DATABASE_URL=postgresql://neondb_owner:SUA_SENHA@SEU_HOST.neon.tech/neondb?sslmode=require

# URL do frontend no Cloudflare Pages (configure após o deploy do frontend)
# Exemplo: https://praticosys.pages.dev
FRONTEND_URL=https://SEU_PROJETO.pages.dev

# Segredo de sessão (use uma string aleatória longa)
APP_SESSION_SECRET=coloque_aqui_um_segredo_muito_forte_e_aleatorio

# Flags opcionais (deixe false em produção)
ENABLE_INTERNAL_DIAGNOSTICS=false
ENABLE_DESTRUCTIVE_OPERATIONS=false
ENABLE_HTTP_LOGS=false
